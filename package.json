{
  "name": "nalarostore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/db-sanity.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "wrangler types --strict-vars=false --include-runtime=false",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "dev:full": "node --import tsx scripts/dev-server.ts",
    "check": "npm run types && npm run db:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.46.0"
  }
}
