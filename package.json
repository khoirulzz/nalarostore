{
  "name": "nalarostore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev-server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run deploy:worker",
    "deploy:worker": "npm run typecheck && wrangler deploy --config wrangler.worker.jsonc --keep-vars",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name nalarostore",
    "check:worker": "wrangler deploy --config wrangler.worker.jsonc --dry-run --outdir .wrangler/worker-build",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/db-sanity.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "wrangler types --config wrangler.worker.jsonc --strict-vars=false --include-runtime=false",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "dev:full": "node --import tsx scripts/dev-server.ts",
    "check": "npm run types && npm run db:check && npm run typecheck && npm test && npm run build",
    "dev:ui": "vite",
    "dev:test": "node --import tsx scripts/test-server.ts",
    "dev:auth-test": "npx -y firebase-tools@latest emulators:start --only auth --project demo-nalarostore --config firebase.test.json",
    "db:status": "node --import tsx scripts/db-status.ts"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.46.0"
  }
}
