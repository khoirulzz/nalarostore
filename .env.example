# Copy to .env.local. npm run dev starts UI + API. Database credentials never use VITE_*.
APP_ORIGIN=http://localhost:5173
ROOT_DOMAIN=nalaro.store
# Worker HTML source for storefront metadata; use pages.dev, not APP_ORIGIN.
PAGES_ORIGIN=https://nalarostore.pages.dev
OWNER_EMAIL=uniquefactuhl@gmail.com

# Public Firebase Web SDK configuration from your project.
VITE_FIREBASE_API_KEY=AIzaSyAymTQU-0lwS_p7yLe0JgsFlNkZPpUo8ow
VITE_FIREBASE_AUTH_DOMAIN=nalarostore.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nalarostore
VITE_FIREBASE_STORAGE_BUCKET=nalarostore.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=195576574363
VITE_FIREBASE_APP_ID=1:195576574363:web:8eb7987abfbbd4cb8d313e
VITE_FIREBASE_MEASUREMENT_ID=G-T9YQXXZ55W
# Server validates only identities from this Firebase project.
FIREBASE_PROJECT_ID=nalarostore
FIREBASE_API_KEY=AIzaSyAymTQU-0lwS_p7yLe0JgsFlNkZPpUo8ow

# pglite = disposable local database; aiven = explicit persistent remote database.
LOCAL_DATABASE_MODE=pglite
DATABASE_URL=
# URL example: postgresql://USER:URL_ENCODED_PASSWORD@nalarostore-pg-uniquefactuhl-7887.e.aivencloud.com:23466/defaultdb
# Alternatively fill PG* fields; PGPASSWORD accepts the unencoded password.
PGHOST=
PGPORT=23466
PGDATABASE=defaultdb
PGUSER=
PGPASSWORD=
# Aiven TLS requires its CA certificate. Choose file OR base64.
PG_CA_CERT_FILE=
PG_CA_CERT_BASE64=
# npm run db:migrate applies migrations explicitly. Dev never auto-migrates Aiven.

# Explicit local checkout opt-in. Aiven orders are persistent; production stays false.
ENABLE_LIVE_CHECKOUT=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same value for the same DB; it encrypts guest tracking links.
TOKEN_SECRET=

# Optional Firebase Auth Emulator. Set BOTH only for local development/testing.
VITE_FIREBASE_AUTH_EMULATOR_URL=
FIREBASE_AUTH_EMULATOR_HOST=
LOCAL_MEDIA_DIR=.local-media
# Server-only encrypted backup key, separate from TOKEN_SECRET.
BACKUP_KEY_HEX=

