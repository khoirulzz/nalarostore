# Local UI/demo needs no credentials.
# Migration/backup variables belong only in a trusted server-side environment.
# DATABASE_URL=postgresql://... (never VITE_DATABASE_URL)
# PG_CA_CERT_FILE=/secure/aiven-ca.pem
# PG_CA_CERT_BASE64=...
# BACKUP_KEY_HEX=... (32 random bytes, separate from backup archives)
# Cloudflare TOKEN_SECRET is set through the secret interface, never committed here.
