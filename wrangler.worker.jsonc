{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nalarostore",
  "account_id": "fa9e4b5cc90250f132b17fb7c067490b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  // Pages owns the frontend. These routes share its public origin.
  "routes": [
    { "pattern": "nalaro.store/api/*", "zone_name": "nalaro.store" },
    { "pattern": "nalaro.store/s/*", "zone_name": "nalaro.store" },
    // Redirect legacy/www documents while keeping API requests same-origin.
    { "pattern": "store.nalaro.digital/*", "zone_name": "nalaro.digital" },
    { "pattern": "www.nalaro.store/*", "zone_name": "nalaro.store" },
    // Existing app clients and shared storefront links.
    { "pattern": "store.nalaro.digital/api/*", "zone_name": "nalaro.digital" },
    { "pattern": "store.nalaro.digital/s/*", "zone_name": "nalaro.digital" },
    { "pattern": "www.nalaro.store/api/*", "zone_name": "nalaro.store" },
    { "pattern": "www.nalaro.store/s/*", "zone_name": "nalaro.store" },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nalarostore-media" }],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "5445c942b1a647a9a01b5c9d7eb6e99f" },
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://nalaro.store",
    "PAGES_ORIGIN": "https://nalarostore.pages.dev",
    "ROOT_DOMAIN": "nalaro.store",
    "OWNER_EMAIL": "admin@nalaro.digital",
    "FIREBASE_PROJECT_ID": "nalarostore",
    "FIREBASE_API_KEY": "AIzaSyAymTQU-0lwS_p7yLe0JgsFlNkZPpUo8ow",
    "ENABLE_LIVE_CHECKOUT": "true",
    "EMAIL_FROM": "hello@nalaro.digital",
  },
  "secrets": { "required": ["TOKEN_SECRET"] },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // HYPERDRIVE uses caching disabled and verified Aiven TLS.
  // Add EMAIL only after Email Sending is activated.
  // Optional tenant route *.nalaro.store/* requires ready DNS and TLS.
}
